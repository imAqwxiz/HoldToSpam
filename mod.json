
{
    "geode": "5.10.1",
    "gd": {
        "android": "*"
    },
    "id": "aqwxiz.holdtospam",
    "name": "HoldToSpam",
    "version": "v0.2.0",
    "developer": "aqwxiz",
    "description": "Customizable gameplay spam settings for Geometry Dash.",
    "dependencies": {
        "geode.node-ids": ">=v1.23.3"
    },
    "settings": {
        "general-title": {
            "type": "title",
            "name": "General"
        },
        "cps": {
            "type": "int",
            "name": "Spam CPS",
            "description": "Number of complete press/release cycles per second.",
            "default": 10,
            "min": 1,
            "max": 60,
            "control": {
                "slider": true,
                "input": true
            }
        },
        "wave-title": {
            "type": "title",
            "name": "Wave Spam"
        },
        "frame-perfect-wave-spam": {
            "type": "string",
            "name": "Frame Perfect Wave Spam",
            "default": "Mostly",
            "one-of": [
                "Mostly",
                "Always",
                "Never"
            ]
        },
        "spam-accuracy": {
            "type": "int",
            "name": "Spam Accuracy",
            "description": "99 means minimal timing variation.",
            "default": 99,
            "min": 1,
            "max": 99,
            "control": {
                "slider": true,
                "input": true
            }
        }
    }
}

